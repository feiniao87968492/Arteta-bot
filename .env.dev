HOST=0.0.0.0
PORT=8088
DEBUG=false
# FASTAPI_RELOAD 在此环境中不可用（uvicorn 需要 app 字符串路径才支持 reload）
SUPERUSERS=["2648955710"]
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.9
COMMAND_START=["", "/"]
zhipu_api_key=
FOOTBALL_API_TOKEN=
BISON_USE_PIC=true # 将长文本或某些平台的推文转换为图片发送，避免 QQ 风控
BISON_INIT_FILTER=true # 启动时过滤掉旧消息，只推送启动后的新消息

# 图片生成
IMAGE_API_KEY=
IMAGE_API_URL=https://www.boxying.com
IMAGE_MODEL=gpt-image-2

# 图片识别（Vision）
VISION_API_KEY=
VISION_API_URL=https://www.boxying.com
VISION_MODEL=gpt-4o
VISION_TIMEOUT=60

# Optional GrokSearch web backend for Agent web_search/web_fetch/verify_recent_claim.
# Leave blank to use the built-in Bing/DuckDuckGo/Jina fallback chain.
ARTETA_GROKSEARCH_API_URL=
ARTETA_GROKSEARCH_API_KEY=
ARTETA_GROKSEARCH_MODEL=
ARTETA_GROKSEARCH_TIMEOUT=80

# Optional authenticated X/Twitter fetch bridge for Agent fetch_x_post.
ARTETA_X_FETCH_API_URL=
ARTETA_X_FETCH_API_KEY=
